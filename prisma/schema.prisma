// Issue Logger v2 data model.
// Projects own issues; users reach projects through ProjectMember roles.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueType {
  BUG
  FEATURE
  TASK
  INCIDENT
}

enum IssueSource {
  MANUAL
  API
}

enum ActivityKind {
  CREATED
  FIELD_CHANGED
  COMMENTED
  OCCURRED
  REGRESSED
}

enum NotificationType {
  ASSIGNED
  COMMENTED
  MENTIONED
  STATUS_CHANGED
  REGRESSED
  SLA_AT_RISK
  SLA_BREACHED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ─── Accounts ───────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  emailVerified  DateTime?
  /// Bumped to revoke every session (password change, "sign out everywhere").
  sessionVersion Int       @default(0)
  /// Notification types to email, keyed by NotificationType (missing keys use lib/email-prefs defaults).
  emailPrefs     Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships    ProjectMember[]
  assignedIssues Issue[]         @relation("IssueAssignee")
  reportedIssues Issue[]         @relation("IssueReporter")
  comments       Comment[]
  activities     Activity[]
  notifications  Notification[]  @relation("NotificationRecipient")
  triggered      Notification[]  @relation("NotificationActor")
  apiKeys        ApiKey[]
  invitesSent    ProjectInvite[]
  savedViews     SavedView[]
}

/// Single-use tokens for email verification and password reset.
/// Only the SHA-256 hash is stored; the raw token lives in the emailed link.
model AuthToken {
  id         String    @id @default(cuid())
  identifier String
  type       TokenType
  tokenHash  String    @unique
  expires    DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
}

// ─── Projects ───────────────────────────────────────────────────────

model Project {
  id           String   @id @default(cuid())
  key          String   @unique @db.VarChar(6)
  name         String   @db.VarChar(80)
  description  String   @default("") @db.Text
  color        String   @default("#6366f1") @db.VarChar(7)
  issueCounter Int      @default(0)
  /// Soft work-in-progress limits per board column, e.g. {"IN_PROGRESS": 5}.
  wipLimits    Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members    ProjectMember[]
  issues     Issue[]
  labels     Label[]
  apiKeys    ApiKey[]
  invites    ProjectInvite[]
  views      SavedView[]
  slaTargets SlaTarget[]
  webhooks   Webhook[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// Invitation for an email with no account yet; accepted automatically on sign-up.
model ProjectInvite {
  id          String      @id @default(cuid())
  projectId   String
  email       String
  role        ProjectRole @default(MEMBER)
  invitedById String?
  createdAt   DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([projectId, email])
  @@index([email])
}

/// Response and resolution targets for one priority, in minutes (null = no target).
model SlaTarget {
  id             String        @id @default(cuid())
  projectId      String
  priority       IssuePriority
  respondMinutes Int?
  resolveMinutes Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, priority])
}

/// A named list-view filter, private to its owner.
model SavedView {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  name      String   @db.VarChar(40)
  query     String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String @db.VarChar(32)
  color     String @default("#64748b") @db.VarChar(7)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, name])
}

/// Project-scoped key for the ingestion API. Only a SHA-256 hash is stored.
model ApiKey {
  id          String    @id @default(cuid())
  projectId   String
  name        String    @db.VarChar(60)
  prefix      String    @db.VarChar(16)
  hashedKey   String    @unique
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ─── Issues ─────────────────────────────────────────────────────────

model Issue {
  id              String        @id @default(cuid())
  projectId       String
  number          Int
  title           String        @db.VarChar(255)
  description     String        @default("") @db.Text
  status          IssueStatus   @default(TODO)
  priority        IssuePriority @default(NONE)
  type            IssueType     @default(TASK)
  /// Fractional sort key inside a board column; lower sorts first.
  position        Float         @default(0)
  assigneeId      String?
  reporterId      String?
  dueDate         DateTime?
  estimate        Int?
  source          IssueSource   @default(MANUAL)
  /// Dedupe key for API-reported issues: repeat events bump `occurrences`.
  fingerprint     String?       @db.VarChar(64)
  occurrences     Int           @default(1)
  lastSeenAt      DateTime?
  environment     String?       @db.VarChar(40)
  closedAt        DateTime?
  parentId        String?
  /// First acknowledgement by the team (work started, or a comment from someone other than the reporter).
  firstResponseAt DateTime?
  /// Highest SLA alert already sent: 0 none, 1 at risk, 2 breached.
  slaAlert        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Issue?         @relation("SubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children      Issue[]        @relation("SubIssues")
  assignee      User?          @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter      User?          @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  labels        Label[]
  comments      Comment[]
  activities    Activity[]
  notifications Notification[]

  @@unique([projectId, number])
  @@unique([projectId, fingerprint])
  @@index([projectId, status, position])
  @@index([assigneeId, status])
  @@index([projectId, createdAt])
  @@index([parentId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
}

/// Append-only audit trail shown on the issue timeline.
model Activity {
  id        String       @id @default(cuid())
  issueId   String
  actorId   String?
  kind      ActivityKind
  field     String?      @db.VarChar(32)
  fromValue String?
  toValue   String?
  createdAt DateTime     @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  issueId   String
  type      NotificationType
  readAt    DateTime?
  /// Set when this notification has been emailed, or skipped by preference.
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([emailedAt, createdAt])
}

/// Fixed-window counters shared by every server instance (see lib/shared-rate-limit.ts).
/// Keys are hashed, so emails and API keys aren't stored here.
model RateLimit {
  key     String   @id @db.VarChar(80)
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ─── Integrations ───────────────────────────────────────────────────

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Outgoing HTTP endpoint notified about project events (generic JSON, Slack or Discord).
model Webhook {
  id              String    @id @default(cuid())
  projectId       String
  url             String    @db.VarChar(500)
  /// HMAC-SHA256 key for the X-IssueLogger-Signature header.
  secret          String    @db.VarChar(80)
  events          String[]
  active          Boolean   @default(true)
  createdById     String?
  lastStatus      Int?
  lastError       String?   @db.VarChar(300)
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
}

/// Outbox row: written in the same transaction as the change it describes,
/// delivered afterwards with retries (lib/outbox.ts).
model WebhookDelivery {
  id            String         @id @default(cuid())
  webhookId     String
  event         String         @db.VarChar(40)
  payload       Json
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  responseCode  Int?
  error         String?        @db.VarChar(300)
  createdAt     DateTime       @default(now())
  deliveredAt   DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}
