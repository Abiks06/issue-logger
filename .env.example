# Copy to .env and fill in.

# Postgres. DIRECT_URL is used for migrations (e.g. Supabase session pooler); it can match DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/issue_logger"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/issue_logger"

# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Public URL used in emails and API responses.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email: set RESEND_API_KEY, or the SMTP_* values. Leave all empty in development to auto-verify sign-ups.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Issue Logger <no-reply@example.com>"

# Protects GET /api/cron/sla (SLA alert sweep). Send as "Authorization: Bearer <secret>".
CRON_SECRET=""

# Optional: report this app's own server errors into one of its projects. Create a project and an
# API key in it, then paste the key here. SELF_MONITOR_URL defaults to NEXT_PUBLIC_APP_URL.
SELF_MONITOR_API_KEY=""
SELF_MONITOR_URL=""
